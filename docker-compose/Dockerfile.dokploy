# Production build of ControlR.Web.Server for the Dokploy deployment.
# ControlR.Web.Server/Dockerfile copies project files that no longer exist
# (e.g. Libraries/ControlR.Libraries.Clients), so this one copies the whole
# context and lets restore resolve the project graph.
# Build context: repository root (see docker-compose.dokploy.yml).

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
RUN apt-get update \
  && apt-get -y install --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/*
USER $APP_UID
WORKDIR /app
EXPOSE 8080

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS publish
ARG BUILD_CONFIGURATION=Release
ARG CURRENT_VERSION=0.0.0
WORKDIR /src
COPY . .
RUN dotnet publish "ControlR.Web.Server/ControlR.Web.Server.csproj" \
  -c $BUILD_CONFIGURATION \
  -p:Version=$CURRENT_VERSION -p:FileVersion=$CURRENT_VERSION \
  -p:UseAppHost=false \
  -o /app/publish

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "ControlR.Web.Server.dll"]

HEALTHCHECK \
  CMD curl -f http://localhost:8080/health || exit 1
